{
  "name": "jl-chess-pro",
  "version": "1.0.0",
  "description": "Juego de ajedrez escolar",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.josue.jlchesspro",
    "productName": "JL Chess Pro",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
